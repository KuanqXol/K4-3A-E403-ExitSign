# SlideAlive — cấu hình gọi LLM. File này KHÔNG được commit (.gitignore: .env*).
# Điền giá trị rồi chạy: npm run eval  |  npm run turn -- "câu hỏi"  |  npm run dev

# Bắt buộc khi dùng OpenAI (bỏ trống được nếu OPENAI_BASE_URL trỏ tới server local)
OPENAI_API_KEY=

# Để trống = https://api.openai.com/v1
# Model local (Ollama/LM Studio): http://127.0.0.1:11434/v1
OPENAI_BASE_URL=

# Để trống = gpt-4o-mini
OPENAI_MODEL=

# Để trống = 0.2
OPENAI_TEMPERATURE=

# Để trống = <repo>/data/vlearn-pack
VLEARN_DATA_DIR=

# Để trống = codebase/logs (trace, llm_calls.jsonl, question_log.jsonl)
SLIDEALIVE_LOG_DIR=
